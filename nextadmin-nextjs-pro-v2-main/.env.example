# ═══════════════════════════════════════════════════════════════════════════
# FusionMarkt Admin Panel - Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local (development) or .env (production)
# NEVER commit .env files to git!
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (Required)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fusionmarkt"

# ─────────────────────────────────────────────────────────────────────────────
# NEXTAUTH (Required)
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-super-secret-key-min-32-characters"
NEXTAUTH_URL="https://admin.fusionmarkt.com"

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE SSO FOR ADMIN (Optional)
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-admin-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-admin-google-client-secret"

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE R2 (Required for media uploads)
# ─────────────────────────────────────────────────────────────────────────────
# R2, S3 uyumlu API sunar; istemci @aws-sdk/client-s3 olduğu için değişken
# adları AWS_* kaldı. S3_ENDPOINT zorunlu: verilmezse SDK AWS'ye bağlanır.
AWS_REGION="auto"
AWS_ACCESS_KEY_ID="your-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
AWS_S3_BUCKET="fusionmarkt-media"
S3_PREFIX="fusionmarkt"
S3_ENDPOINT="https://<hesap-id>.r2.cloudflarestorage.com"
S3_PUBLIC_BASE_URL="https://cdn.fusionmarkt.com"

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND REVALIDATION (Required)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL="https://fusionmarkt.com"
REVALIDATE_SECRET="your-revalidate-secret-min-32-characters"

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL - RESEND (Required for admin notifications)
# ─────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="FusionMarkt <noreply@fusionmarkt.com>"

# ─────────────────────────────────────────────────────────────────────────────
# NODE ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="production"

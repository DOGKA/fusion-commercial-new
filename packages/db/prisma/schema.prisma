model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String?
  bundleId   String?
  createdAt  DateTime @default(now())
  /// Varyantlı favori. Varyant silinirse kalem varyantsıza döner (SetNull),
  /// ürünü tamamen kaybetmek yerine varyantı kaybetmek tercih edildi.
  variantId  String?
  /// Favoriye eklendiği andaki satış fiyatı — "fiyatı düşenler" filtresi bunu
  /// güncel fiyatla karşılaştırır. Taşınan/eski kayıtlarda null olur ve o
  /// kayıtlar filtreye girmez.
  priceAtAdd Decimal? @db.Decimal(10, 2)

  product  Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  bundle   Bundle?         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  wishlist Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// ⚠️ variantId nullable olduğu için PostgreSQL aynı ürünü varyantsız olarak
  /// iki kez eklemeyi bu kısıtla engelleyemez (NULL'lar eşit sayılmaz);
  /// varyantsız tekillik uygulama katmanında kontrol edilir.
  @@unique([wishlistId, productId, variantId])
  @@unique([wishlistId, bundleId])
  @@index([bundleId])
  @@map("wishlist_items")
}

model Address {
  id              String              @id @default(cuid())
  userId          String
  firstName       String?
  lastName        String?
  company         String?
  addressLine1    String?
  addressLine2    String?
  city            String
  state           String?
  postalCode      String?
  country         String              @default("TR")
  phone           String
  isDefault       Boolean             @default(false)
  type            AddressType         @default(BOTH)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  address         String?
  district        String?
  fullName        String?
  title           String?
  /// Ev / İş / Diğer. Mevcut kayıtlarda null; arayüz null olanlarda
  /// "adres türünü tanımla" uyarı bandı gösterir.
  addressCategory AddressCategory?
  /// Fatura adresi olarak kullanıldığında bireysel mi kurumsal mı.
  /// null = hiç belirtilmemiş (eski kayıtlar) ⇒ arayüz bireysel varsayar.
  invoiceType     AddressInvoiceType?
  /// Kurumsal fatura alanları. Firma adı için mevcut `company` kolonu
  /// kullanılıyor, yeni kolon açılmadı.
  /// TCKN bilinçli olarak burada TUTULMUYOR: ödeme adımında opsiyonel ve
  /// sipariş anında sözleşme HTML'i içinde zaten saklanıyor; ayrıca profil
  /// verisi olarak süresiz tutmak gereksiz bir KVKK yükü olurdu.
  taxNumber       String?
  taxOffice       String?
  /// Yumuşak silme. Sipariş bu adrese FK ile bağlı ve ilişki opsiyonel olduğu
  /// için gerçek DELETE, geçmiş siparişlerin adresini NULL'a çekiyordu.
  /// Silme artık bu alanı doldurur; liste yalnızca deletedAt = null döner.
  deletedAt       DateTime?

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingOrders  Order[] @relation("BillingAddress")
  shippingOrders Order[] @relation("ShippingAddress")

  @@index([userId, deletedAt])
  @@map("addresses")
}

model Coupon {
  id                 String       @id @default(cuid())
  code               String       @unique
  description        String?
  discountType       DiscountType @default(PERCENTAGE)
  discountValue      Decimal      @db.Decimal(10, 2)
  minOrderAmount     Decimal?     @db.Decimal(10, 2)
  maxDiscount        Decimal?     @db.Decimal(10, 2)
  /// Mağaza geneli kullanım tavanı. null = sınırsız.
  usageLimit         Int?
  /// ⛔ KULLANIMDAN KALDIRILDI — okumayın, yazmayın.
  ///
  /// Sipariş oluşturulurken artıyor, ama iptal veya BAŞARISIZ ÖDEME durumunda
  /// geri alınmıyordu: 50 kişilik bir kupon 50 başarısız kart denemesiyle
  /// tükenmiş görünebiliyordu. Gerçek kullanım artık `Order` tablosundan
  /// hesaplanıyor (`packages/db/src/coupon-usage.ts`), bu kolon hiçbir yerde
  /// okunmuyor ve artık yazılmıyor. Kolonun kendisi, veri kaybı olmasın diye
  /// duruyor; değerleri güncel değildir.
  usageCount         Int          @default(0)
  /// Kişi başı kullanım hakkı. 0 (veya negatif) = sınırsız.
  perUserLimit       Int          @default(1)
  startDate          DateTime     @default(now())
  endDate            DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  /// Kod, TÜM üyelerin Hesabım → Kuponlarım sayfasında LİSTELENİR.
  ///
  /// Bu bayrak kuponun KİMİN KULLANABİLECEĞİNİ değiştirmez — her kupon zaten
  /// kodunu bilen herkes tarafından kullanılabilir. Tek işi DUYURU: kapalıyken
  /// kuponu yalnızca kodu bilenler (e-posta, sosyal medya, kampanya) kullanır;
  /// açıkken kod herkese görünür hale gelir.
  ///
  /// Kaç kez kullanılabileceğini `perUserLimit` belirliyor, bu alan değil.
  ///
  /// `@default(false)`: mevcut kuponların hiçbiri istemeden duyurulmuyor.
  showInMyCoupons    Boolean      @default(false)
  allowedCategories  String[]     @default([])
  allowedProducts    String[]     @default([])
  excludeSaleItems   Boolean      @default(false)
  excludedCategories String[]     @default([])
  excludedProducts   String[]     @default([])
  freeShipping       Boolean      @default(false)
  orders             Order[]

  @@map("coupons")
}


// ═══════════════════════════════════════════════════════════════════════════
// CANCELLATION & RETURN REQUEST ENUMS
// ═══════════════════════════════════════════════════════════════════════════

/// İade talebinin yaşam döngüsü. İki ayrı onay var, çünkü "gönderebilirsin"
/// ile "paran iade edildi" aynı şey değil:
///
///   PENDING_ADMIN_APPROVAL → APPROVED → RECEIVED → COMPLETED
///                         ↘ REJECTED  ↘ REJECTED (inceleme olumsuz)
///
/// APPROVED = inceleme talebi onaylandı, müşteri iade kodunu aldı ve kargoya
/// verebilir. **Para burada çıkmaz.** RECEIVED = koli depoya ulaştı, kodla
/// eşleştirildi. COMPLETED = inceleme olumlu, stok geri yüklendi ve ödeme
/// iade edildi. Para yalnızca bu son adımda hareket eder.
enum RequestStatus {
  PENDING_ADMIN_APPROVAL
  APPROVED
  RECEIVED
  COMPLETED
  REJECTED
}

enum ReturnReason {
  DAMAGED
  WRONG_PRODUCT
  SPECS_MISMATCH
  // Referanstaki talep listesi için eklenenler. CHANGED_MIND cayma hakkı
  // (mesafeli satış) karşılığı; MISSING_ITEM ve NOT_RECEIVED teslim
  // sorunlarıdır ve ürün elde olmadığı için görsel istenmez.
  CHANGED_MIND
  MISSING_ITEM
  NOT_RECEIVED
}

/// Talebin ne olduğunu ayırır. Fatura talebi veya fazla ürün bildirimi
/// iade DEĞİLDİR; hepsi `ReturnReason` içine sıkıştırılırsa admin panelinde
/// iade kuyruğu kirlenir ve iade oranı istatistikleri yanlış çıkar.
enum RequestType {
  RETURN
  INVOICE_REQUEST
  WRONG_INVOICE
  EXTRA_ITEM
  OTHER
}

enum BanType {
  SOFT
  HARD
}


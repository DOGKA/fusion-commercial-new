// ═══════════════════════════════════════════════════════════════════════════
// PRODUCT COMPARISON - Urun Karsilastirma Tablolari
// ═══════════════════════════════════════════════════════════════════════════

model CompareCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  specGroups CompareSpecGroup[]
  products   CompareProduct[]

  @@map("compare_categories")
}

model CompareSpecGroup {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category CompareCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  specs    CompareSpec[]

  @@map("compare_spec_groups")
}

model CompareSpec {
  id      String  @id @default(cuid())
  groupId String
  label   String
  unit    String?
  icon    String?
  order   Int     @default(0)

  group  CompareSpecGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  values CompareProductSpec[]

  @@map("compare_specs")
}

model CompareProduct {
  id           String   @id @default(cuid())
  categoryId   String
  productId    String?
  name         String
  image        String?
  price        Decimal?
  comparePrice Decimal?
  buyLink      String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   CompareCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?             @relation(fields: [productId], references: [id], onDelete: SetNull)
  specValues CompareProductSpec[]

  @@map("compare_products")
}

model CompareProductSpec {
  id               String @id @default(cuid())
  compareProductId String
  specId           String
  value            String

  compareProduct CompareProduct @relation(fields: [compareProductId], references: [id], onDelete: Cascade)
  spec           CompareSpec    @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@unique([compareProductId, specId])
  @@map("compare_product_specs")
}
